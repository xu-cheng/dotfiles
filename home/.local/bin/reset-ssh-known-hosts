#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

hosts = %w[
  github.com
  faith
  faith.comp.hkbu.edu.hk
]

servers = %w[
  portal
  bot
]
hosts += servers.map { |s| "#{s}.srv.xuc.me" }

hashes = hosts.map do |host| # rubocop:disable Style/StringConcatenation
  hash, = Open3.capture2("ssh-keyscan", "-H", host)
  hash.strip!
  hash unless hash.empty?
end.compact.join("\n") + "\n"

File.write("#{Dir.home}/.ssh/known_hosts", hashes)
